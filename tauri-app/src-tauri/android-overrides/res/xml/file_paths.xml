<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider roots. Overrides Tauri's generated default, which also declared
  `<external-path name="my_images" path="." />` — the whole of shared external
  storage.

  That root is dropped deliberately. The only file this app ever hands to a
  FileProvider is the update APK that `download_android_update` writes into the
  app cache dir and checksums (MainActivity's `getUriForFile` call is the single
  use). With an external root declared, any APK that any other app had dropped on
  shared storage was addressable through the same bridge — so the root granted
  reach the app has no use for.

  Keep this file in `android-overrides/`: `gen/android/` is gitignored and
  regenerated by `tauri android init`, which would restore the default.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <cache-path name="my_cache_images" path="." />
</paths>
