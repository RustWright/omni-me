<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider roots. Overrides Tauri's generated default, which also declared
  `<external-path name="my_images" path="." />` — the whole of shared external
  storage.

  That root is dropped deliberately: with it, any APK another app had dropped on
  shared storage was addressable through the update installer's bridge.

  Two users, and a missing root fails silently for each. The update APK in the
  cache dir (MainActivity). And wry's camera capture, which writes to the app's
  own `getExternalFilesDir(Pictures)`; without `captures` below, wry falls back
  to the file picker and the camera never opens.

  Keep this file in `android-overrides/`: `gen/android/` is gitignored and
  regenerated by `tauri android init`, which would restore the default.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <cache-path name="my_cache_images" path="." />
  <external-files-path name="captures" path="Pictures/" />
</paths>
