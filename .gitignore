.log/
target/
node_modules/
tauri-app/src-tauri/gen/android/
# Build-generated and PER-TARGET, which made them actively dangerous to track:
# an Android build drops the `updater` key from acl-manifests.json (the plugin is
# `#[cfg(desktop)]`) and never writes the desktop/linux schemas, so committing
# after an APK build silently removed the desktop updater's manifest entry.
# tauri-build regenerates whatever the current target needs on every build.
tauri-app/src-tauri/gen/schemas/
*.apk
*.db
*.db-*
surreal_data/
blobs/
.reference/
.tmp/
.claude/worktrees/
.claude/scheduled_tasks.lock
.playwright-mcp/
reviews/
# Raw bench scorecards from scripts/bench-slate.sh. The conclusions belong in
# docs/src/assistant.md and tasks.md; the transcripts are working output, and a
# failed run's log can carry an upstream error body verbatim.
runs/
.curiosities/
logbook/_drafts/
logbook/_assets/
/*.png

# mdbook build output — the site is built in CI and published to Pages
docs/book/
ui_dev/
UI_design.md
tauri-app/frontend/assets/tailwind.css
.env
.env.*
!.env.example
secrets/*
!secrets/*.example

# Local privacy guard: real bank/personal tokens for the pre-commit scan.
.private-identity-denylist
